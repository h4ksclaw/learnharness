## LearnHarness Configuration
##
## Copy to .env and adjust. All values are optional — defaults work
## with the included Docker Compose (local Ollama).
##
##   cp .env.example .env

# ── LLM Backend ──────────────────────────────────────────────
# Any OpenAI-compatible endpoint. Examples:

# Local Ollama (default, no API key needed):
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=not-needed

# z.ai (GLM models — provider-aware JSON mode & tool-calling):
# Available models: glm-4.5, glm-4.5-air, glm-4.6, glm-4.7, glm-5, glm-5.1, glm-5.2
#
# API plan (pay-as-you-go):
# LLM_BASE_URL=https://api.z.ai/api/paas/v4
#
# Coding plan (includes free tier, uses different endpoint):
# LLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
#
# LLM_MODEL=glm-4.7
# LLM_API_KEY=your-zai-api-key

# OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o
# LLM_API_KEY=sk-...

# Groq (free tier, fast):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=your-groq-key

# ── Embeddings (optional, for semantic search) ───────────────
# Only needed if your LLM backend supports embeddings.
# Ollama: nomic-embed-text · OpenAI: text-embedding-3-small
EMBEDDING_MODEL=nomic-embed-text

# ── Database ─────────────────────────────────────────────────
# Default uses the Docker Compose Postgres. For external DB:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://lh:lh_dev@db:5432/learnharness

# ── Ports ────────────────────────────────────────────────────
API_PORT=8000
WEB_PORT=3000
OLLAMA_PORT=11434

# ── Learning Engine (optional tuning) ────────────────────────
# FSRS target retention rate (0-1)
FSRS_TARGET_RETENTION=0.9
# BKT parameters
BKT_PRIOR=0.5
BKT_SLIP=0.1
BKT_GUESS=0.25
BKT_TRANSIT=0.1
# Heartbeat interval (seconds between proactive checks)
HEARTBEAT_INTERVAL_SECONDS=300
